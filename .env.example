# Copy to .env (never commit it). Values below are placeholders.

# direct = plain HTTP (default). oxylabs = Oxylabs Web Scraper API (JS rendering, geo).
FETCH_BACKEND=direct
OXYLABS_USER=
OXYLABS_PASS=
OXYLABS_GEO_LOCATION=

# Anthropic API key (or any endpoint compatible with the Anthropic Messages API).
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=claude-haiku-5-5

# Shared secret between the runner and the API (optional but recommended).
LLM_SCRAPER_INTERNAL_TOKEN=

OCR_LANGUAGES=eng+spa
CAPTURE_TIMEZONE=UTC
